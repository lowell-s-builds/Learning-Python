# Create fruits, vegetables and animal products tuples. Join the three tuples and assign it to a variable called food_stuff_tp.

fruits = ('apples','bananas','kiwi')
vegatables = ('potatos','carrots','lettuce')
animal_products = ('beef','pork','chicken')

food_stuff_tp = fruits+vegatables+animal_products
print(food_stuff_tp)

# Change the about food_stuff_tp tuple to a food_stuff_lt list

food_stuff_list = list(food_stuff_tp)

# Slice out the middle item or items from the food_stuff_tp tuple or food_stuff_lt list.

food_stuff_list = food_stuff_list[0:4] + food_stuff_list[5:9]

print(food_stuff_list)
# Slice out the first three items and the last three items from food_stuff_lt list

food_stuff_list = food_stuff_list [3:7]
print(food_stuff_list)

# Delete the food_stuff_tp tuple completely

del food_stuff_tp

# Check if an item exists in tuple:
food_stuff_tp = ()

food_stuff_tp = tuple(food_stuff_list)

print('pork' in food_stuff_tp)

