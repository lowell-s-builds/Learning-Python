# The following is a list of 10 students ages:

# ages = [19, 22, 19, 24, 20, 25, 26, 24, 25, 24]

# Sort the list and find the min and max age
ages = [19, 22, 19, 24, 20, 25, 26, 24, 25, 24]

ages.sort()

min,max = ages[0],ages[-1]

print(min,max)

# Add the min age and the max age again to the list

ages.insert(0,min)
ages.insert(-1,max)

print(ages)

# Find the median age (one middle item or two middle items divided by two)
# need to use function here. there is a lib (statistics) that does this easily but manually we have to set it up

def median(ages):
    s = sorted(ages)
    n = len(s)
    mid = n // 2 
    if n % 2: 
        return s[mid]
    return (s[mid - 1] + s[mid])/2

print(median(ages))

# Find the average age (sum of all items divided by their number )
# we can define a function for it but sum is built in 

avg = sum(ages) / len(ages)

print(avg)

# Find the range of the ages (max minus min) 

range = ages[-1] - ages[0] # be careful here it is already sorted so there is no sort function.

print(range)

# Compare the value of (min - average) and (max - average), use abs() method

min_avg = abs(min - avg)
max_avg = abs(max - avg)

print(min_avg,max_avg)

